{
  "version": 5,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "dev", "displayName": "Debug with system dependencies",
      "generator": "Ninja", "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}
    },
    {
      "name": "bootstrap", "inherits": "dev", "binaryDir": "${sourceDir}/build/bootstrap",
      "cacheVariables": {"SHADOW_FETCH_DEPENDENCIES": "ON"}
    },
    {
      "name": "asan", "inherits": "dev", "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {"SHADOW_SANITIZERS": "ON"}
    }
  ],
  "buildPresets": [
    {"name": "dev", "configurePreset": "dev"},
    {"name": "bootstrap", "configurePreset": "bootstrap"},
    {"name": "asan", "configurePreset": "asan"}
  ],
  "testPresets": [
    {"name": "dev", "configurePreset": "dev", "output": {"outputOnFailure": true}},
    {"name": "bootstrap", "configurePreset": "bootstrap", "output": {"outputOnFailure": true}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}}
  ]
}
